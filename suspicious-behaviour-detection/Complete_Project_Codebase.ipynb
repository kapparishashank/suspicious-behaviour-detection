    "## 2. Model Training\n",
    "\n",
    "### 2.1 Fine-tuning YOLOv8 for Human Detection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from ultralytics import YOLO\n",
    "import os\n",
    "\n",
    "DATA_YAML = r'c:\\Users\\sadam\\OneDrive\\Documents\\Field project\\data.yaml'\n",
    "\n",
    "def train_custom_yolo():\n",
